(object Class_Category "PROPUESTA DE MEJORA" quid "6AD70000003E" documentation "Registro único y seguimiento del pedido: propuesta académica de mejora del proceso actual." exportControl "Public" logical_models (list unit_reference_list (object Class_Category "MODELO DE NEGOCIO PROPUESTO" quid "6AD700000020" stereotype "Business Use Case Model" exportControl "Public" logical_models (list unit_reference_list (object Class "Cliente" quid "6AD700000001" documentation "Solicita productos y recibe su factura." stereotype "Business Actor")
(object Class "Vendedor" quid "6AD700000002" documentation "Registra una sola vez la solicitud del cliente y consulta su estado." stereotype "Business Worker")
(object Class "Operadora" quid "6AD700000003" documentation "Revisa las validaciones del sistema y acepta u observa el pedido." stereotype "Business Worker")
(object Class "Despachador" quid "6AD700000004" documentation "Prepara el paquete y registra su salida con la nota de despacho." stereotype "Business Worker")
(object Class "Transportes" quid "6AD700000005" documentation "Recibe el paquete y la nota para el transporte." stereotype "Business Worker")
(object Class "Responsable de facturación" quid "6AD700000006" documentation "Emite la factura después de confirmar el despacho." stereotype "Business Worker")
(object UseCase "Gestionar pedido" quid "6AD700000007" documentation "El vendedor registra la solicitud en un único registro. La operadora revisa existencias y crédito y valida u observa el pedido." stereotype "Business Use Case")
(object UseCase "Despachar pedido" quid "6AD700000008" documentation "Se prepara el paquete y la nota con el mismo número de pedido. El despachador registra la salida y entrega el paquete a transportes." stereotype "Business Use Case")
(object UseCase "Facturar pedido" quid "6AD700000009" documentation "El responsable emite la factura de un pedido despachado y la envía al cliente." stereotype "Business Use Case")
(object Association "$UNNAMED$4000" quid "6AD70000000A" roles (list role_list (object Role "$UNNAMED$4002" quid "6AD70000000C" supplier "Use Case View::PROPUESTA DE MEJORA::MODELO DE NEGOCIO PROPUESTO::Gestionar pedido" quidu "6AD700000007" is_navigable TRUE) (object Role "$UNNAMED$4001" quid "6AD70000000B" supplier "Use Case View::PROPUESTA DE MEJORA::MODELO DE NEGOCIO PROPUESTO::Cliente" quidu "6AD700000001")))
