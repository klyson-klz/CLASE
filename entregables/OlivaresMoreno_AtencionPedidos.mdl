(object Class_Category "MODELO DE REQUERIMIENTO FUNCIONAL" quid "6AD600000020" exportControl "Public" logical_models (list unit_reference_list (object Class "Operadora" quid "6AD600000001" documentation "Consulta existencias y crédito, registra y verifica los pedidos, actualiza su situación y habilita la facturación." stereotype "Actor")
(object Class "Responsable de facturación" quid "6AD600000002" documentation "Rol que prepara la factura del pedido. El caso no precisa su cargo ni si esta función corresponde a la propia operadora." stereotype "Actor")
(object UseCase "Consultar existencias" quid "6AD600000003" documentation "Consulta los saldos de almacén para revisar la disponibilidad de los productos solicitados.")
(object UseCase "Consultar crédito del cliente" quid "6AD600000004" documentation "Consulta la cuenta corriente y el crédito autorizado para evaluar el monto del pedido.")
(object UseCase "Registrar pedido" quid "6AD600000005" documentation "Registra el número de pedido, cliente, vendedor y monto total después de revisar existencias y crédito.")
(object UseCase "Verificar datos del pedido" quid "6AD600000006" documentation "Consulta el registro y contrasta sus datos con el pedido impreso entregado por el vendedor.")
(object UseCase "Actualizar situación del pedido" quid "6AD600000007" documentation "Marca el pedido como atendido cuando recibe la copia de la nota que confirma la salida del paquete.")
(object UseCase "Habilitar facturación" quid "6AD600000008" documentation "Activa la opción de facturación del pedido después de marcarlo como atendido.")
(object UseCase "Emitir factura" quid "6AD600000009" documentation "Prepara la factura de un pedido atendido, con la facturación habilitada, para enviarla al cliente después del despacho.")
(object Association "$UNNAMED$300" quid "6AD60000000A" roles (list role_list (object Role "$UNNAMED$302" quid "6AD60000000C" supplier "Use Case View::MODELO DE REQUERIMIENTO FUNCIONAL::Consultar existencias" quidu "6AD600000003" is_navigable TRUE) (object Role "$UNNAMED$301" quid "6AD60000000B" supplier "Use Case View::MODELO DE REQUERIMIENTO FUNCIONAL::Operadora" quidu "6AD600000001")))
