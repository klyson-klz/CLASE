(object Class_Category "MODELO DE REQUERIMIENTO FUNCIONAL PROPUESTO" quid "6AD70000003D" exportControl "Public" logical_models (list unit_reference_list (object Class "Vendedor" quid "6AD700000021" documentation "Registra la solicitud del cliente y consulta el estado de sus pedidos." stereotype "Actor")
(object Class "Operadora" quid "6AD700000022" documentation "Valida el pedido y consulta su estado." stereotype "Actor")
(object Class "Despachador" quid "6AD700000023" documentation "Registra la nota y confirma la salida del pedido." stereotype "Actor")
(object Class "Responsable de facturación" quid "6AD700000024" documentation "Emite la factura de un pedido despachado." stereotype "Actor")
(object UseCase "Registrar solicitud" quid "6AD700000025" documentation "Guarda una sola vez el cliente, vendedor, detalle y monto y asigna el número único del pedido.")
(object UseCase "Validar pedido" quid "6AD700000026" documentation "Consulta existencias y crédito. Permite a la operadora validar u observar el pedido y registrar el motivo.")
(object UseCase "Consultar estado del pedido" quid "6AD700000027" documentation "Muestra el estado del mismo pedido y las observaciones registradas.")
(object UseCase "Registrar salida del pedido" quid "6AD700000028" documentation "Guarda la nota de despacho, confirma la salida y marca el pedido como despachado; habilita automáticamente su facturación.")
